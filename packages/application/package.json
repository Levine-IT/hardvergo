{
  "name": "@hardvergo/application",
  "version": "0.1.0",
  "description": "Application layer - Use cases and application services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "pnpm lint:fix && pnpm format",
		"lint": "eslint \"src/**/*.ts\"",
		"lint:fix": "eslint \"src/**/*.ts\" --fix",
		"format": "eslint \"src/**/*.ts\" --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hardvergo/domain": "workspace:*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.31.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.34.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.37.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    },
    "./*/*": {
      "types": "./dist/*/*/index.d.ts",
      "default": "./dist/*/*/index.js"
    }
  }
}