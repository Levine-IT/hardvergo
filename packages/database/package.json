{
	"name": "@hardvergo/database",
	"version": "1.0.0",
	"description": "Shared database package for HardverGO",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push"
	},
	"dependencies": {
		"drizzle-orm": "^0.44.4",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/pg": "^8.15.5",
		"drizzle-kit": "^0.31.4",
		"typescript": "^5.7.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	}
}